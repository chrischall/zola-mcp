{
  "name": "zola-mcp",
  "version": "1.4.1",
  "mcpName": "io.github.chrischall/zola-mcp",
  "description": "Zola wedding MCP server for Claude",
  "author": "Claude Code (AI) <https://www.anthropic.com/claude>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischall/zola-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "zola",
    "wedding",
    "wedding-planning",
    "model-context-protocol",
    "claude",
    "ai",
    "vendors",
    "registry",
    "guests",
    "budget",
    "seating",
    "rsvp"
  ],
  "files": [
    "dist",
    ".claude-plugin",
    "skills",
    ".mcp.json",
    "server.json"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "bin": {
    "zola-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --external:dotenv --banner:js='import { createRequire as __createRequire } from \"module\"; const require = __createRequire(import.meta.url);' --outfile=dist/bundle.js",
    "dev": "node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chrischall/mcp-utils": "^0.7.0",
    "@fetchproxy/bootstrap": "^1.3.0",
    "@fetchproxy/server": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
